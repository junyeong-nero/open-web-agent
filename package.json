{
  "name": "open-web-agent",
  "version": "0.2.0",
  "private": true,
  "description": "A small browser agent and browser MCP server",
  "type": "module",
  "bin": {
    "owa": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "owa": "bun run src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --timeout 30000 src",
    "eval": "bun scripts/evaluate.ts",
    "bench": "bun scripts/bench.ts"
  },
  "dependencies": {
    "playwright": "1.61.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  }
}
